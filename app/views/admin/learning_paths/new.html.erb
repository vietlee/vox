<% content_for :title, t("learning_path.new_title") %>

<div class="flex items-center gap-3 mb-4">
  <%= render "admin/shared/back_btn" %>
  <h1 class="text-[20px] font-extrabold text-slate-900">🗺️ <%= t("learning_path.new_title") %></h1>
</div>

<!-- Step guide -->
<div class="flex items-center gap-3 mb-6">
  <div class="flex items-center gap-2 px-3 py-1.5 bg-indigo-600 text-white text-[12px] font-bold rounded-full">
    <span class="w-4 h-4 bg-white text-indigo-600 rounded-full flex items-center justify-center text-[10px] font-black">1</span>
    Đặt tên lộ trình
  </div>
  <div class="flex-1 h-px bg-slate-200"></div>
  <div class="flex items-center gap-2 px-3 py-1.5 bg-slate-100 text-slate-400 text-[12px] font-bold rounded-full">
    <span class="w-4 h-4 bg-slate-300 text-white rounded-full flex items-center justify-center text-[10px] font-black">2</span>
    Thêm bài học
  </div>
  <div class="flex-1 h-px bg-slate-200"></div>
  <div class="flex items-center gap-2 px-3 py-1.5 bg-slate-100 text-slate-400 text-[12px] font-bold rounded-full">
    <span class="w-4 h-4 bg-slate-300 text-white rounded-full flex items-center justify-center text-[10px] font-black">3</span>
    Giao cho Learner
  </div>
</div>

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
  <%= form_with model: @learning_path, url: learning_paths_path, local: true do |f| %>
    <div class="space-y-4">
      <div>
        <label class="block text-[12px] font-bold text-slate-700 mb-1 uppercase tracking-wide">Tiêu đề lộ trình *</label>
        <p class="text-[11px] text-slate-400 mb-1.5">Chỉ cần nhập tiêu đề — AI sẽ tự tạo toàn bộ bài học. Các mục khác là tùy chọn.</p>
        <%= f.text_field :title, required: true,
            placeholder: "VD: Ôn thi Toán THPT, Python căn bản, Giao tiếp tiếng Anh...",
            class: "w-full px-3 py-2.5 border border-slate-200 rounded-xl text-[14px] focus:border-indigo-500 outline-none" %>
      </div>
      <details class="group border border-slate-200 rounded-xl overflow-hidden">
        <summary class="flex items-center justify-between gap-3 px-4 py-3 cursor-pointer select-none text-[13px] font-semibold text-slate-700 hover:bg-slate-50 transition-colors list-none [&::-webkit-details-marker]:hidden">
          <span class="min-w-0">⚙️ Tùy chọn nâng cao <span class="hidden sm:inline font-normal text-slate-400">— mô tả / yêu cầu cho AI</span></span>
          <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-slate-600 hover:bg-slate-700 text-white text-[12px] font-bold whitespace-nowrap shadow-sm">
            <span class="group-open:hidden">Mở ▾</span>
            <span class="hidden group-open:inline">Đóng ▴</span>
          </span>
        </summary>
        <div class="space-y-4 px-4 pb-4 pt-1 border-t border-slate-100">
          <div>
            <label class="block text-[12px] font-bold text-slate-700 mb-1 uppercase tracking-wide">Mô tả & yêu cầu cho AI</label>
            <p class="text-[11px] text-slate-400 mb-1.5">AI sẽ dựa vào đây để tạo lộ trình phù hợp — nội dung này cũng hiển thị cho học viên.</p>
            <%= f.text_area :description, rows: 4,
                placeholder: "VD: Cho học sinh lớp 12 ôn thi; 8 bài từ cơ bản đến nâng cao, mỗi bài ~15 phút, có quiz cuối mỗi phần...",
                class: "w-full px-3 py-2.5 border border-slate-200 rounded-xl text-[14px] focus:border-indigo-500 outline-none resize-none" %>
          </div>
        </div>
      </details>
      <div class="flex flex-wrap items-center gap-2 pt-1">
        <button type="submit" name="generate" value="ai"
          class="px-5 py-2.5 bg-violet-600 hover:bg-violet-700 text-white text-[13px] font-bold rounded-xl cursor-pointer transition-colors">
          ✨ Tạo bằng AI · <%= CreditCost[:learning_path_generate] %> credits
        </button>
        <button type="submit" name="generate" value="manual"
          class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[13px] font-semibold rounded-xl cursor-pointer transition-colors">
          Tự thêm bài học →
        </button>
        <%= link_to "Hủy", learning_paths_path, class: "px-5 py-2.5 text-slate-500 hover:text-slate-700 text-[13px] font-semibold rounded-xl transition-colors" %>
      </div>
    </div>
  <% end %>
</div>
