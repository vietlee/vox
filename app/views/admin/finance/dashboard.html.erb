<% content_for :title, "Thu – Chi" %>
<% fmt = ->(c){ "#{c.to_i.to_s.reverse.gsub(/\d{3}(?=.)/,'\0.').reverse} ₫" } %>

<div class="max-w-[1100px] mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-5 flex-wrap gap-3">
    <div>
      <h1 class="text-[22px] font-extrabold text-slate-800">💰 Quản lý Thu – Chi</h1>
      <p class="text-[13px] text-slate-500">Theo dõi học phí, thu chi và doanh thu của bạn.</p>
    </div>
    <div class="flex gap-1.5 bg-slate-100 rounded-xl p-1">
      <% [["month","Tháng này"],["quarter","Quý này"],["year","Năm nay"]].each do |val,lbl| %>
        <%= link_to lbl, finance_path(range: val),
              class: "px-3 py-1.5 rounded-lg text-[13px] font-semibold #{(params[:range].presence||'month')==val ? 'bg-white text-[#1e3a5f] shadow-sm' : 'text-slate-500'}" %>
      <% end %>
    </div>
  </div>

  <!-- Summary cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl border border-emerald-100 bg-emerald-50 p-4">
      <p class="text-[12px] font-semibold text-emerald-700">Doanh thu (thu vào)</p>
      <p class="text-[24px] font-extrabold text-emerald-700 mt-1"><%= fmt.(@income_total) %></p>
    </div>
    <div class="rounded-2xl border border-rose-100 bg-rose-50 p-4">
      <p class="text-[12px] font-semibold text-rose-600">Chi phí</p>
      <p class="text-[24px] font-extrabold text-rose-600 mt-1"><%= fmt.(@expense_total) %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-[#1e3a5f] p-4">
      <p class="text-[12px] font-semibold text-white/70">Còn lại (lợi nhuận)</p>
      <p class="text-[24px] font-extrabold text-white mt-1"><%= fmt.(@net) %></p>
    </div>
  </div>

  <!-- Tuition by class -->
  <div class="rounded-2xl border border-slate-200 bg-white p-4 mb-6">
    <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
      <h2 class="text-[15px] font-bold text-slate-800">🎓 Học phí theo lớp</h2>
      <span class="text-[12px] text-slate-500"><%= TuitionPayment.period_label(@period_key) %></span>
    </div>
    <% if @class_summaries.empty? %>
      <p class="text-[13px] text-slate-400 py-6 text-center">Chưa có lớp nào. Tạo lớp ở mục Học viên trước.</p>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% @class_summaries.each do |cs| %>
          <% f = cs[:folder] %>
          <%= link_to finance_class_path(f), class: "block rounded-xl border border-slate-200 hover:border-[#1e3a5f]/40 p-3 transition" do %>
            <div class="flex items-center justify-between">
              <p class="font-bold text-slate-800 text-[14px]"><%= f.name %></p>
              <span class="text-[11px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-600"><%= f.cycle_quarterly? ? "Theo quý" : "Theo tháng" %></span>
            </div>
            <div class="flex items-center gap-4 mt-2 text-[12px]">
              <span class="text-slate-500">Học phí: <b class="text-slate-700"><%= f.tuition_amount_cents > 0 ? fmt.(f.tuition_amount_cents) : "chưa đặt" %></b></span>
            </div>
            <div class="flex items-center gap-2 mt-2">
              <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                <div class="h-full bg-emerald-500" style="width: <%= cs[:total] > 0 ? (cs[:paid]*100/cs[:total]) : 0 %>%"></div>
              </div>
              <span class="text-[12px] font-semibold text-slate-600"><%= cs[:paid] %>/<%= cs[:total] %> đã nộp</span>
            </div>
            <p class="text-[12px] text-emerald-600 mt-1 font-semibold">Đã thu: <%= fmt.(cs[:collected]) %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Quick add + ledger -->
    <div class="rounded-2xl border border-slate-200 bg-white p-4">
      <h2 class="text-[15px] font-bold text-slate-800 mb-3">📒 Ghi khoản thu / chi</h2>
      <%= form_with url: finance_entries_path, method: :post, local: true, class: "space-y-2.5" do |form| %>
        <%= form.fields_for :finance_entry do |ff| %>
          <div class="flex gap-2">
            <label class="flex-1 flex items-center justify-center gap-1.5 py-2 rounded-lg border border-emerald-200 bg-emerald-50 cursor-pointer text-[13px] font-semibold text-emerald-700 has-[:checked]:ring-2 has-[:checked]:ring-emerald-400">
              <%= ff.radio_button :kind, "income", checked: true, class: "accent-emerald-600" %> Thu vào
            </label>
            <label class="flex-1 flex items-center justify-center gap-1.5 py-2 rounded-lg border border-rose-200 bg-rose-50 cursor-pointer text-[13px] font-semibold text-rose-600 has-[:checked]:ring-2 has-[:checked]:ring-rose-400">
              <%= ff.radio_button :kind, "expense", class: "accent-rose-600" %> Chi ra
            </label>
          </div>
          <%= ff.number_field :amount_cents, placeholder: "Số tiền (VND)", required: true, min: 1,
                class: "w-full px-3 py-2.5 border border-slate-200 rounded-lg text-[14px] focus:border-[#1e3a5f] outline-none" %>
          <div class="flex gap-2">
            <%= ff.date_field :occurred_on, value: Date.current, required: true,
                  class: "flex-1 px-3 py-2.5 border border-slate-200 rounded-lg text-[13px] outline-none" %>
            <%= ff.text_field :category, placeholder: "Danh mục (VD Thuê phòng)",
                  class: "flex-1 px-3 py-2.5 border border-slate-200 rounded-lg text-[13px] outline-none" %>
          </div>
          <%= ff.collection_select :learner_folder_id, @folders, :id, :name,
                { include_blank: "— Gắn lớp (tùy chọn) —" },
                { class: "w-full px-3 py-2.5 border border-slate-200 rounded-lg text-[13px] outline-none bg-white" } %>
          <%= ff.text_field :note, placeholder: "Ghi chú",
                class: "w-full px-3 py-2.5 border border-slate-200 rounded-lg text-[13px] outline-none" %>
        <% end %>
        <%= form.submit "Lưu khoản", class: "w-full py-2.5 rounded-lg bg-[#1e3a5f] text-white font-semibold text-[14px] cursor-pointer" %>
      <% end %>
    </div>

    <!-- AI import -->
    <div class="rounded-2xl border border-slate-200 bg-white p-4">
      <h2 class="text-[15px] font-bold text-slate-800 mb-1">✨ Nhập bằng AI</h2>
      <p class="text-[12px] text-slate-500 mb-3">Tải ảnh (biên lai, danh sách nộp tiền, sao kê) hoặc dán văn bản — AI bóc dữ liệu để bạn xem & sửa trước khi nhập.</p>
      <input type="file" id="ai-image" accept="image/*" class="block w-full text-[13px] mb-2 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-slate-100 file:text-slate-600" />
      <textarea id="ai-text" rows="3" placeholder="Hoặc dán văn bản danh sách thu/chi..." class="w-full px-3 py-2 border border-slate-200 rounded-lg text-[13px] outline-none mb-2"></textarea>
      <button id="ai-extract-btn" class="w-full py-2.5 rounded-lg bg-violet-600 text-white font-semibold text-[14px]">Bóc dữ liệu bằng AI</button>
      <div id="ai-preview" class="mt-3 hidden">
        <p class="text-[12px] font-semibold text-slate-600 mb-1.5">Xem lại & sửa trước khi nhập:</p>
        <div id="ai-rows" class="space-y-1.5 max-h-64 overflow-y-auto"></div>
        <%= form_with url: finance_ai_import_path, method: :post, local: true, id: "ai-import-form" do |f| %>
          <div id="ai-rows-hidden"></div>
          <button type="submit" class="w-full mt-2 py-2.5 rounded-lg bg-emerald-600 text-white font-semibold text-[14px]">Nhập các khoản này</button>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Ledger list -->
  <div class="rounded-2xl border border-slate-200 bg-white p-4 mt-6">
    <h2 class="text-[15px] font-bold text-slate-800 mb-3">📜 Lịch sử thu chi gần đây</h2>
    <% if @entries.empty? %>
      <p class="text-[13px] text-slate-400 py-6 text-center">Chưa có khoản nào.</p>
    <% else %>
      <div class="divide-y divide-slate-100">
        <% @entries.each do |e| %>
          <div class="flex items-center gap-3 py-2.5">
            <span class="w-8 h-8 rounded-lg flex items-center justify-center text-[15px] <%= e.income? ? 'bg-emerald-50' : 'bg-rose-50' %>"><%= e.income? ? "⬇️" : "⬆️" %></span>
            <div class="flex-1 min-w-0">
              <p class="text-[13px] font-semibold text-slate-700 truncate"><%= e.category.presence || (e.income? ? "Thu" : "Chi") %><% if e.learner_folder %> · <span class="text-slate-400"><%= e.learner_folder.name %></span><% end %></p>
              <p class="text-[11px] text-slate-400 truncate"><%= l e.occurred_on, format: :long rescue e.occurred_on %><%= " · #{e.note}" if e.note.present? %></p>
            </div>
            <span class="text-[14px] font-bold <%= e.income? ? 'text-emerald-600' : 'text-rose-600' %>"><%= e.income? ? "+" : "−" %><%= fmt.(e.amount_cents) %></span>
            <%= button_to finance_entry_path(e), method: :delete, form: { data: { turbo_confirm: "Xoá khoản này?" } },
                  class: "text-slate-300 hover:text-rose-500 text-[16px] leading-none px-1" do %>×<% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script>
(function(){
  const btn = document.getElementById('ai-extract-btn');
  if (!btn) return;
  const token = document.querySelector('meta[name="csrf-token"]')?.content;
  btn.addEventListener('click', async () => {
    const img = document.getElementById('ai-image').files[0];
    const text = document.getElementById('ai-text').value;
    if (!img && !text.trim()) { alert('Chọn ảnh hoặc dán văn bản.'); return; }
    btn.disabled = true; btn.textContent = 'Đang bóc dữ liệu...';
    const fd = new FormData();
    if (img) fd.append('image', img);
    fd.append('text', text);
    try {
      const res = await fetch('<%= finance_ai_extract_path %>', { method:'POST', headers:{'X-CSRF-Token':token}, body: fd });
      const data = await res.json();
      if (data.error) throw new Error(data.error);
      renderRows(data.rows || []);
    } catch(e) { alert('Lỗi: ' + e.message); }
    btn.disabled = false; btn.textContent = 'Bóc dữ liệu bằng AI';
  });

  function renderRows(rows){
    const wrap = document.getElementById('ai-rows');
    const hidden = document.getElementById('ai-rows-hidden');
    wrap.innerHTML=''; hidden.innerHTML='';
    if (!rows.length){ wrap.innerHTML = '<p class="text-[13px] text-slate-400">AI không tìm thấy khoản nào.</p>'; document.getElementById('ai-preview').classList.remove('hidden'); return; }
    rows.forEach((r,i) => {
      const row = document.createElement('div');
      row.className = 'flex gap-1.5 items-center';
      row.innerHTML = `
        <select data-f="kind" class="border border-slate-200 rounded px-1.5 py-1 text-[12px]">
          <option value="income" ${r.kind!=='expense'?'selected':''}>Thu</option>
          <option value="expense" ${r.kind==='expense'?'selected':''}>Chi</option>
        </select>
        <input data-f="date" type="date" value="${r.date||''}" class="border border-slate-200 rounded px-1.5 py-1 text-[12px] w-[130px]">
        <input data-f="amount" value="${r.amount||''}" placeholder="VND" class="border border-slate-200 rounded px-1.5 py-1 text-[12px] w-[90px]">
        <input data-f="category" value="${r.category||''}" placeholder="Danh mục" class="border border-slate-200 rounded px-1.5 py-1 text-[12px] flex-1 min-w-0">`;
      wrap.appendChild(row);
    });
    // mirror into hidden fields on submit
    document.getElementById('ai-import-form').addEventListener('submit', () => {
      hidden.innerHTML='';
      wrap.querySelectorAll(':scope > div').forEach((row,i) => {
        row.querySelectorAll('[data-f]').forEach(inp => {
          const h=document.createElement('input'); h.type='hidden';
          h.name=`rows[${i}][${inp.dataset.f}]`; h.value=inp.value; hidden.appendChild(h);
        });
      });
    }, { once:false });
    document.getElementById('ai-preview').classList.remove('hidden');
  }
})();
</script>
