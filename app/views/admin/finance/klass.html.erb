<% content_for :title, "Học phí · #{@folder.name}" %>
<% fmt = ->(c){ "#{c.to_i.to_s.reverse.gsub(/\d{3}(?=.)/,'\0.').reverse} ₫" } %>

<div class="max-w-[820px] mx-auto px-4 py-6">
  <%= link_to "← Thu – Chi", finance_path, class: "text-[13px] text-slate-500 hover:text-[#1e3a5f]" %>
  <div class="flex items-center justify-between mt-2 mb-4 flex-wrap gap-2">
    <h1 class="text-[20px] font-extrabold text-slate-800">🎓 <%= @folder.name %></h1>
    <% if @periods.size > 1 || @folder.tuition_payments.exists? %>
      <form method="get" action="<%= finance_class_path(@folder) %>">
        <select name="period" onchange="this.form.submit()" class="px-3 py-1.5 border border-slate-200 rounded-lg text-[13px] bg-white outline-none">
          <% @periods.each do |k| %>
            <option value="<%= k %>" <%= 'selected' if k==@period_key %>><%= TuitionPayment.period_label(k) %></option>
          <% end %>
        </select>
      </form>
    <% end %>
  </div>

  <!-- Tuition plan -->
  <div class="rounded-2xl border border-slate-200 bg-white p-4 mb-4">
    <h2 class="text-[14px] font-bold text-slate-700 mb-2">Mức học phí</h2>
    <%= form_with url: finance_tuition_plan_path(@folder), method: :post, local: true, class: "flex flex-wrap items-end gap-2" do |f| %>
      <div>
        <label class="block text-[11px] text-slate-500 mb-1">Số tiền / kỳ</label>
        <%= number_field_tag :tuition_amount_cents, @folder.tuition_amount_cents, min: 0,
              class: "px-3 py-2 border border-slate-200 rounded-lg text-[14px] w-[150px] outline-none" %>
      </div>
      <div>
        <label class="block text-[11px] text-slate-500 mb-1">Chu kỳ</label>
        <%= select_tag :tuition_cycle, options_for_select([["Theo tháng","monthly"],["Theo quý","quarterly"]], @folder.tuition_cycle),
              class: "px-3 py-2 border border-slate-200 rounded-lg text-[14px] bg-white outline-none" %>
      </div>
      <%= hidden_field_tag :period, @period_key %>
      <%= f.submit "Lưu", class: "px-4 py-2 rounded-lg bg-[#1e3a5f] text-white font-semibold text-[13px] cursor-pointer" %>
    <% end %>
  </div>

  <!-- Roster -->
  <div class="rounded-2xl border border-slate-200 bg-white p-4">
    <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
      <h2 class="text-[14px] font-bold text-slate-700">Danh sách nộp — <%= TuitionPayment.period_label(@period_key) %></h2>
      <%= button_to "＋ Tạo danh sách kỳ này", finance_generate_roster_path(@folder, period_key: @period_key), method: :post,
            class: "px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 font-semibold text-[12px]" %>
    </div>

    <% if @records.empty? %>
      <p class="text-[13px] text-slate-400 py-6 text-center">Chưa có danh sách. Đặt học phí rồi bấm “Tạo danh sách kỳ này”.</p>
    <% else %>
      <% paid = @records.select(&:paid?).size %>
      <div class="flex items-center gap-2 mb-3">
        <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
          <div class="h-full bg-emerald-500" style="width: <%= @records.size>0 ? paid*100/@records.size : 0 %>%"></div>
        </div>
        <span class="text-[12px] font-semibold text-slate-600"><%= paid %>/<%= @records.size %> đã nộp · thu <%= fmt.(@records.select(&:paid?).sum(&:amount_cents)) %></span>
      </div>
      <div class="divide-y divide-slate-100">
        <% @records.each do |r| %>
          <div class="flex items-center gap-3 py-2.5">
            <div class="flex-1 min-w-0">
              <p class="text-[13.5px] font-semibold text-slate-700 truncate"><%= r.learner.name %></p>
              <p class="text-[11px] text-slate-400"><%= fmt.(r.amount_cents) %><%= " · nộp #{l r.paid_on, format: :long rescue r.paid_on}" if r.paid? && r.paid_on %></p>
            </div>
            <% if r.paid? %>
              <span class="text-[11px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold">Đã nộp</span>
              <%= button_to "Hoàn tác", finance_mark_unpaid_path(r), method: :post,
                    class: "text-[12px] text-slate-400 hover:text-rose-500 underline" %>
            <% else %>
              <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 font-semibold">Chưa nộp</span>
              <%= button_to "Đánh dấu đã nộp", finance_mark_paid_path(r), method: :post,
                    class: "text-[12px] px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-semibold" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
