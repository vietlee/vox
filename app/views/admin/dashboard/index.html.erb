<% content_for :title, t("dashboard.title") %>

<!-- Header -->
<div class="flex items-start justify-between mb-6">
  <div>
    <h1 class="text-[21px] font-extrabold text-slate-900 tracking-tight"><%= t("dashboard.title") %></h1>
    <p class="text-[13px] text-slate-500 mt-0.5"><%= current_workspace.name %> · <%= Date.current.strftime("%B %Y") %></p>
  </div>
</div>

<!-- KPI row — teacher-focused, 2 rows x 4 cols -->
<div class="grid grid-cols-4 gap-3 mb-6" style="grid-auto-rows: 72px">
  <%= link_to learner_folders_path, class: "bg-white border border-slate-200 rounded-[10px] shadow-sm px-4 py-3.5 overflow-hidden hover:shadow-md transition-shadow group flex items-center gap-3" do %>
    <span class="text-2xl">👥</span>
    <div>
      <div class="text-[11px] text-slate-400 uppercase tracking-wide font-medium"><%= t("dashboard.stat_learners") %></div>
      <div class="text-[20px] font-extrabold text-slate-900 group-hover:text-sky-600 transition-colors leading-tight"><%= @learners_count %></div>
    </div>
  <% end %>
  <%= link_to learner_folders_path, class: "bg-white border border-slate-200 rounded-[10px] shadow-sm px-4 py-3.5 overflow-hidden hover:shadow-md transition-shadow group flex items-center gap-3" do %>
    <span class="text-2xl">🏫</span>
    <div>
      <div class="text-[11px] text-slate-400 uppercase tracking-wide font-medium"><%= t("dashboard.stat_classes") %></div>
      <div class="text-[20px] font-extrabold text-slate-900 group-hover:text-indigo-600 transition-colors leading-tight"><%= @classes_count %></div>
    </div>
  <% end %>
  <div class="bg-white border border-slate-200 rounded-[10px] shadow-sm px-4 py-3.5 overflow-hidden flex items-center gap-3">
    <span class="text-2xl">🟢</span>
    <div>
      <div class="text-[11px] text-slate-400 uppercase tracking-wide font-medium"><%= t("dashboard.stat_active") %></div>
      <div class="text-[20px] font-extrabold text-slate-900 leading-tight"><%= @active_learners %><span class="text-[13px] text-slate-400 font-semibold"> / <%= @learners_count %></span></div>
    </div>
  </div>
  <%= link_to learner_folders_path, class: "bg-white border border-slate-200 rounded-[10px] shadow-sm px-4 py-3.5 overflow-hidden hover:shadow-md transition-shadow group flex items-center gap-3" do %>
    <span class="text-2xl">📨</span>
    <div>
      <div class="text-[11px] text-slate-400 uppercase tracking-wide font-medium"><%= t("dashboard.stat_assignments") %></div>
      <div class="text-[20px] font-extrabold text-slate-900 group-hover:text-teal-600 transition-colors leading-tight"><%= @assignments_count %></div>
    </div>
  <% end %>
  <%= link_to quiz_sets_path, class: "bg-white border border-slate-200 rounded-[10px] shadow-sm px-4 py-3.5 overflow-hidden hover:shadow-md transition-shadow group flex items-center gap-3" do %>
    <span class="text-2xl">🧠</span>
    <div>
      <div class="text-[11px] text-slate-400 uppercase tracking-wide font-medium"><%= t("dashboard.stat_quiz") %></div>
      <div class="text-[20px] font-extrabold text-slate-900 group-hover:text-indigo-600 transition-colors leading-tight"><%= @quiz_sets_count %></div>
    </div>
  <% end %>
  <%= link_to flashcard_decks_path, class: "bg-white border border-slate-200 rounded-[10px] shadow-sm px-4 py-3.5 overflow-hidden hover:shadow-md transition-shadow group flex items-center gap-3" do %>
    <span class="text-2xl">🃏</span>
    <div>
      <div class="text-[11px] text-slate-400 uppercase tracking-wide font-medium"><%= t("dashboard.stat_flashcard") %></div>
      <div class="text-[20px] font-extrabold text-slate-900 group-hover:text-orange-600 transition-colors leading-tight"><%= @flashcard_decks_count %></div>
    </div>
  <% end %>
  <%= link_to learning_paths_path, class: "bg-white border border-slate-200 rounded-[10px] shadow-sm px-4 py-3.5 overflow-hidden hover:shadow-md transition-shadow group flex items-center gap-3" do %>
    <span class="text-2xl">🗺️</span>
    <div>
      <div class="text-[11px] text-slate-400 uppercase tracking-wide font-medium"><%= t("dashboard.stat_paths") %></div>
      <div class="text-[20px] font-extrabold text-slate-900 group-hover:text-blue-600 transition-colors leading-tight"><%= @learning_paths_count %></div>
    </div>
  <% end %>
  <!-- AI Credits mini -->
  <% if (sub = @subscription) %>
    <div class="bg-white border border-slate-200 rounded-[10px] shadow-sm px-4 py-3.5 overflow-hidden flex items-center gap-3">
      <span class="text-2xl">🎯</span>
      <div class="flex-1 min-w-0">
        <div class="text-[11px] text-slate-400 uppercase tracking-wide font-medium"><%= t("dashboard.ai_credits") %></div>
        <div class="text-[13px] font-bold text-slate-900 leading-tight"><%= sub.credit_balance %> / <%= sub.max_ai_credits.to_i > 0 ? sub.max_ai_credits : "∞" %></div>
        <div class="h-1 bg-slate-100 rounded-full mt-1 overflow-hidden">
          <div class="h-1 bg-gradient-to-r from-indigo-500 to-violet-500 rounded-full" style="width:<%= sub.max_ai_credits.to_i > 0 ? sub.credit_percentage : 100 %>%"></div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- Main 2-column layout -->
<div class="grid grid-cols-[1fr_280px] gap-5">

  <!-- Left column -->
  <div class="space-y-5">

    <!-- My classes + Recent submissions -->
    <div class="grid grid-cols-2 gap-5">

      <!-- My classes -->
      <div class="bg-white rounded-[10px] border border-slate-200 shadow-sm p-4">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-[13px] font-bold text-slate-900"><%= t("dashboard.section_classes") %></h2>
          <%= link_to t("dashboard.view_all"), learner_folders_path, class: "text-[11px] text-indigo-600 hover:underline" %>
        </div>
        <% if @classes.any? %>
          <% @classes.each do |folder| %>
            <% unread = folder.unread_count_for(current_user) %>
            <%= link_to learner_folder_path(folder), class: "flex items-center gap-3 py-2.5 border-b border-slate-100 last:border-0 hover:bg-slate-50 -mx-1 px-1 rounded-lg" do %>
              <div class="w-7 h-7 bg-indigo-50 rounded-lg flex items-center justify-center shrink-0 text-sm">🏫</div>
              <div class="flex-1 min-w-0">
                <div class="text-[12px] font-semibold text-slate-900 truncate"><%= folder.name %></div>
                <div class="text-[10px] text-slate-400"><%= t("dashboard.n_learners", count: folder.member_count) %></div>
              </div>
              <% if unread > 0 %>
                <span class="text-[10px] px-2 py-0.5 bg-indigo-50 text-indigo-700 rounded-full font-bold flex-shrink-0">💬 <%= unread %></span>
              <% else %>
                <span class="text-[10px] text-slate-300 flex-shrink-0">💬</span>
              <% end %>
            <% end %>
          <% end %>
        <% else %>
          <div class="text-center py-6">
            <p class="text-[12px] text-slate-400"><%= t("dashboard.no_classes") %></p>
            <%= link_to t("dashboard.new_class"), new_learner_folder_path, class: "text-[11px] text-indigo-600 mt-1 hover:underline block" %>
          </div>
        <% end %>
      </div>

      <!-- Recent submissions -->
      <div class="bg-white rounded-[10px] border border-slate-200 shadow-sm p-4">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-[13px] font-bold text-slate-900"><%= t("dashboard.section_submissions") %></h2>
          <%= link_to t("dashboard.view_all"), quiz_sets_path, class: "text-[11px] text-indigo-600 hover:underline" %>
        </div>
        <% if @recent_submissions.any? %>
          <% @recent_submissions.each do |att| %>
            <% passed = att.passed? rescue false %>
            <div class="flex items-center gap-3 py-2.5 border-b border-slate-100 last:border-0">
              <div class="flex-1 min-w-0">
                <div class="text-[12px] font-semibold text-slate-900 truncate"><%= att.participant_name.presence || "—" %></div>
                <div class="text-[10px] text-slate-400 truncate"><%= att.quiz_set&.title %></div>
              </div>
              <span class="text-[11px] font-bold flex-shrink-0 <%= passed ? "text-emerald-600" : "text-red-500" %>">
                <%= att.score_pct.round rescue 0 %>% · <%= passed ? t("dashboard.badge_passed") : t("dashboard.badge_failed") %>
              </span>
            </div>
          <% end %>
        <% else %>
          <p class="text-[12px] text-slate-400 text-center py-6"><%= t("dashboard.no_submissions_recent") %></p>
        <% end %>
      </div>

    </div>

    <!-- Recent content -->
    <div class="bg-white rounded-[10px] border border-slate-200 shadow-sm p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-[13px] font-bold text-slate-900"><%= t("dashboard.section_content") %></h2>
      </div>
      <% if @recent_content.any? %>
        <% type_meta = { quiz: ["🧠", t("dashboard.type_quiz")], flashcard: ["🃏", t("dashboard.type_flashcard")], path: ["🗺️", t("dashboard.type_path")] } %>
        <% @recent_content.each do |c| %>
          <% icon, label = type_meta[c[:type]] %>
          <%= link_to c[:path], class: "flex items-center gap-3 py-2.5 border-b border-slate-100 last:border-0 hover:bg-slate-50 -mx-1 px-1 rounded-lg" do %>
            <div class="w-7 h-7 bg-slate-50 rounded-lg flex items-center justify-center shrink-0 text-sm"><%= icon %></div>
            <div class="flex-1 min-w-0">
              <div class="text-[12px] font-semibold text-slate-900 truncate"><%= c[:title] %></div>
            </div>
            <span class="text-[10px] text-slate-400 flex-shrink-0"><%= label %> · <%= c[:at].strftime("%b %d") %></span>
          <% end %>
        <% end %>
      <% else %>
        <p class="text-[12px] text-slate-400 text-center py-6"><%= t("dashboard.no_content") %></p>
      <% end %>
    </div>

    <!-- Secondary engagement (de-emphasized) -->
    <div class="flex items-center gap-4 px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-[10px] text-[11px] text-slate-400">
      <span class="text-slate-500 font-semibold"><%= t("dashboard.label_other") %>:</span>
      <%= link_to surveys_path, class: "hover:text-slate-600" do %>📋 <%= t("dashboard.stat_surveys") %> <%= @surveys_count %><% end %>
      <%= link_to votes_path, class: "hover:text-slate-600" do %>🗳️ <%= t("dashboard.stat_votes") %> <%= @votes_count %><% end %>
      <%= link_to feedback_boards_path, class: "hover:text-slate-600" do %>💬 <%= t("dashboard.stat_feedback") %> <%= @feedbacks_count %><% end %>
    </div>

  </div>

  <!-- Right sidebar: AI tools -->
  <div class="space-y-4">
    <div class="bg-gradient-to-br from-violet-50 to-indigo-50 border border-violet-200 rounded-[10px] p-4">
      <h2 class="text-[13px] font-bold text-slate-900 mb-3"><%= t("dashboard.section_ai_tools") %></h2>
      <div class="space-y-2">
        <%= link_to ai_chat_page_path, class: "flex items-center gap-2.5 px-3 py-2.5 bg-white rounded-xl hover:shadow-sm transition-all border border-violet-100 group" do %>
          <span class="text-base">💬</span>
          <div class="flex-1 min-w-0">
            <div class="text-[12px] font-semibold text-slate-800"><%= t("dashboard.ai_tools_chat") %></div>
            <div class="text-[10px] text-slate-400"><%= t("dashboard.ai_tools_chat_sub") %></div>
          </div>
          <svg class="w-3.5 h-3.5 text-slate-300 group-hover:text-violet-500 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <% end %>
        <%= link_to ai_tutor_page_path, class: "flex items-center gap-2.5 px-3 py-2.5 bg-white rounded-xl hover:shadow-sm transition-all border border-violet-100 group" do %>
          <span class="text-base">🎓</span>
          <div class="flex-1 min-w-0">
            <div class="text-[12px] font-semibold text-slate-800"><%= t("dashboard.ai_tools_tutor") %></div>
            <div class="text-[10px] text-slate-400"><%= t("dashboard.ai_tools_tutor_sub") %></div>
          </div>
          <svg class="w-3.5 h-3.5 text-slate-300 group-hover:text-violet-500 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <% end %>
        <%= link_to new_content_outline_path, class: "flex items-center gap-2.5 px-3 py-2.5 bg-white rounded-xl hover:shadow-sm transition-all border border-violet-100 group" do %>
          <span class="text-base">🖥️</span>
          <div class="flex-1 min-w-0">
            <div class="text-[12px] font-semibold text-slate-800"><%= t("dashboard.ai_tools_slide") %></div>
            <div class="text-[10px] text-slate-400"><%= t("dashboard.ai_tools_slide_sub") %></div>
          </div>
          <svg class="w-3.5 h-3.5 text-slate-300 group-hover:text-violet-500 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <% end %>
        <%= link_to new_document_summary_path, class: "flex items-center gap-2.5 px-3 py-2.5 bg-white rounded-xl hover:shadow-sm transition-all border border-violet-100 group" do %>
          <span class="text-base">📄</span>
          <div class="flex-1 min-w-0">
            <div class="text-[12px] font-semibold text-slate-800"><%= t("dashboard.ai_tools_summary") %></div>
            <div class="text-[10px] text-slate-400"><%= t("dashboard.ai_tools_summary_sub") %></div>
          </div>
          <svg class="w-3.5 h-3.5 text-slate-300 group-hover:text-violet-500 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <% end %>
      </div>
    </div>
  </div>
</div>
